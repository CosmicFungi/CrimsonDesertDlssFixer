<Window x:Class="CrimsonDesertDlssFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CrimsonDesertDlssFixer.Converters"
        Title="Crimson Desert DLSS &amp; MFG Diagnostic &amp; Fixer"
        Width="1060" Height="800" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:SeverityBrushConverter x:Key="SeverityBrush"/>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:FixStatusBrushConverter x:Key="FixStatusBrush"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="26" CornerRadius="3" Background="{StaticResource AccentCrimson}" Margin="0,0,10,0"/>
                        <TextBlock Text="Crimson Desert — DLSS, MFG &amp; RHI Repair Tool"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="Finds and cleans hidden NVIDIA DRS driver overrides, Streamline mismatches, corrupted Pearl Abyss XML configs, RHI caches, and leftover mod files."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="20,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="GpuNameText" Text="Scanning GPU..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="DriverVersionText" Text="Driver: ..." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RescanButton" Content="Rescan System" Style="{StaticResource SecondaryButton}" Click="RescanButton_Click"/>
                </StackPanel>

                <!-- Game Path Selector -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Game Folder:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <TextBox x:Name="GamePathTextBox" Grid.Column="1"
                             Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                             Padding="10,6" FontSize="12.5" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- RHI RUNNING WARNING BANNER -->
        <Border x:Name="RhiRunningBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#3B1D0B" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock Foreground="#FDE68A" FontSize="12.5" TextWrapping="Wrap"
                       Text="Warning: RHI.exe is currently running. Close RHI before applying fixes so it does not re-write settings.json or NVIDIA DRS overrides."/>
        </Border>

        <!-- KPI SUMMARY BAR -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CRITICAL ISSUES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="CriticalCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F87171"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="WARNINGS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="WarningCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FBBF24"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="AUTO-FIXABLE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="FixableCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#34D399"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="HAGS &amp; LATEST STREAMLINE LOG" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="HagsSummaryText" Text="HAGS: ..." FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LogSummaryText" Text="Log: ..." FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DIAGNOSTIC ISSUES LIST -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IssuesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCardAlt}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsFixable}"
                                              Visibility="{Binding IsFixable, Converter={StaticResource BoolVis}}"
                                              VerticalAlignment="Top" Margin="0,4,12,0"/>

                                    <StackPanel Grid.Column="1">
                                        <!-- Top badge row -->
                                        <WrapPanel Margin="0,0,0,6">
                                            <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                    CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding SeverityLabel}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="#111827" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                    CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                            </Border>
                                            <Border Background="{Binding FixStatus, Converter={StaticResource FixStatusBrush}}"
                                                    Visibility="{Binding FixStatus, Converter={StaticResource NonEmptyVis}}"
                                                    CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding FixStatus}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Title & Summary -->
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                        <!-- Technical Details Box -->
                                        <Border Visibility="{Binding TechnicalDetails, Converter={StaticResource NonEmptyVis}}"
                                                Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                            <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}"
                                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                     Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11.5"
                                                     TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Fix Action Preview -->
                                        <Border Visibility="{Binding FixDescription, Converter={StaticResource NonEmptyVis}}"
                                                Background="#0D221B" BorderBrush="#14532D" BorderThickness="1"
                                                CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                            <TextBlock FontSize="12" Foreground="#A7F3D0" TextWrapping="Wrap">
                                                <Run Text="Planned Fix: " FontWeight="Bold"/>
                                                <Run Text="{Binding FixDescription, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ACTIVITY LOG -->
        <Expander Grid.Row="4" Header="Activity &amp; Repair Log" IsExpanded="False" x:Name="LogExpander"
                  Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0">
            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0" Height="130">
                <TextBox x:Name="ActivityLogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </Border>
        </Expander>

        <!-- BOTTOM ACTION BAR -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Select All Recommended" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="SelectRecommendedButton_Click"/>
                <Button x:Name="RestoreButton" Content="Restore Last Backup" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RestoreBackupButton_Click"/>
                <Button Content="Open Backups Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenBackupsButton_Click"/>
                <Button Content="Export Report" Style="{StaticResource SecondaryButton}" Click="ExportReportButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Margin="0,0,14,0"
                           FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                <Button x:Name="FixSelectedButton" Content="Fix Selected Issues (Auto-Backup)"
                        Style="{StaticResource PrimaryButton}" Click="FixSelectedButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
