<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CrimsonDesertDlssFixer</AssemblyName>
    <RootNamespace>CrimsonDesertDlssFixer</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Crimson Desert DLSS &amp; MFG Fixer</Product>
    <Description>Diagnoses and repairs Crimson Desert DLSS, Frame Generation, MFG, Streamline, NVIDIA DRS, Pearl Abyss XML, and RHI mod leftovers.</Description>
  </PropertyGroup>

</Project>
